# 复制为 .env，填写后运行：uv run --locked main.py --check
# 程序自动读取当前目录的 .env；进程环境变量优先。不要提交真实 .env。
# 字符串含空格、# 或特殊字符时用单引号包裹；${...} 保留原文，不做变量展开。
SEU_CARD_NUMBER=
SEU_PASSWORD=

# 列表使用 JSON 数组，外层使用单引号。指定标题仍须满足其他筛选及冲突规则。
# 目标固定为已打卡8场人文与科学素养系列讲座、法律/艺术/心理各1；沙龙可预约，但不计入目标。
SEU_PREFERRED_LECTURES='[]'
SEU_REQUIRED_CATEGORIES='["人文与科学素养系列讲座_心理健康","人文与科学素养系列讲座_法律","人文与科学素养系列讲座-艺术类","人文与科学素养系列讲座_其他","“SEU咖啡间”系列沙龙活动"]'
# 填写允许的线下校区；留空数组不预约线下。线上是否允许由 SEU_ENABLE_ONLINE 控制。
# 默认列出学校全部校区；可删减为只允许部分校区。
SEU_PREFERRED_CAMPUS='["九龙湖校区","四牌楼校区","丁家桥校区","无锡校区","苏州校区"]'
SEU_ENABLE_ONLINE=true
SEU_ENABLE_OFFLINE=true
SEU_STATE_DIR=state

# 开抢提速实验项，默认开启，可分别关闭：
# SEU_PREWARM=true 在开抢前约 2 秒用主会话刷新一次历史，保持验证码/提交连接热度；超时上界约 1.5 秒，
# 距开放不足 0.4 秒时跳过。
# SEU_CAPTCHA_PREFETCH=true 在开抢前约 0.6 秒预取验证码并识别，候选出现后直接提交，
# 被服务端判错、超时或超过 5 秒未用时会回退为现场取图；距开放不足 0.45 秒时跳过。
# 两项都按活动列表里稳定的学校开抢时间戳去重，同一场最多各执行一次。观测数据见 state/diagnostics.jsonl。
SEU_PREWARM=true
SEU_CAPTCHA_PREFETCH=true
# 实验性开抢对齐（默认关闭）：把某一次后台轮询对齐到开抢时刻。学校时钟为秒级截断且快照有
# 年龄，目标可能比真实开抢晚约 0~1 秒，默认关闭；如需实验请在真实开抢中对比后再开启。
SEU_POLLER_ALIGN=false

# 备用网关 IP：首次登录先使用正常 DNS，网关解析失败、连接关闭/重置或 TLS 意外断开后回退一次。
# 留空关闭回退；IP 可能变更。仍校验域名证书，不改变系统 DNS/TUN，详见 docs/usage.md。
SEU_VPN_IP=121.249.14.2

# 邮件通知可选；邮件配置均留空或缺省时不发邮件，事件仍记录在终端和本地日志。
# QQ／163／126／Gmail 只需完整邮箱地址和授权码，默认自己给自己发信。
# 开启后发送人工认证、查询或预约关键步骤持续五分钟失败、异常退出等重大告警；不发日报或恢复通知。
# SEU_MAIL_SUCCESS=true 时额外发送每次预约成功通知；false 或省略时保持只发重大告警。
# 成功通知由后台线程发送，不阻塞扫描。
# QQ／163／126 填 SMTP 授权码；Gmail 填应用专用密码（16字符，去掉分组空格）。
# 获取步骤见 docs/usage.md；不要填写邮箱网页登录密码。
SEU_MAIL_SUCCESS=true
SMTP_USERNAME=
SMTP_PASSWORD=
# 高级配置按需取消注释；已有完整 SMTP 配置仍可用。使用隐式 TLS。
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=your-address@gmail.com
# MAIL_TO=your-address@gmail.com
