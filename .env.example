# 复制为 .env；Web 使用 seu-reserve-web，旧单账号 CLI 使用 main.py。
# 程序自动读取当前目录的 .env；进程环境变量优先。不要提交真实 .env。
# 字符串含空格、# 或特殊字符时用单引号包裹；${...} 保留原文，不做变量展开。

# Web 管理台：明文 HTTP、无管理员登录，只应部署在可信局域网或 VPN。
# 同网段任何可达机器都能操作管理台并接触明文保存的学校凭据，不要暴露到公网。
SEU_WEB_HOST=0.0.0.0
SEU_WEB_PORT=8080
# Web 账号数据库、manager.lock 与按账号状态都在这里；--account CLI 也读取同一数据根。
# 缺省沿用 SEU_STATE_DIR，再缺省为 state。
SEU_DATA_DIR=state

# 下列学校凭据及筛选用于旧单账号 CLI。Web 在网页中逐账号配置，不继承这些选项。
# 旧单账号任务文件不会自动检测或导入；Web 从空数据根目录开始建立账号。
SEU_CARD_NUMBER=
SEU_PASSWORD=

# 列表使用 JSON 数组，外层使用单引号。指定标题仍须满足其他筛选及冲突规则。
# 目标固定为已打卡8场人文与科学素养系列讲座、法律/艺术/心理各1；沙龙可预约，但不计入目标。
SEU_PREFERRED_LECTURES='[]'
SEU_REQUIRED_CATEGORIES='["人文与科学素养系列讲座_心理健康","人文与科学素养系列讲座_法律","人文与科学素养系列讲座-艺术类","人文与科学素养系列讲座_其他","“SEU咖啡间”系列沙龙活动"]'
# 填写允许的线下校区；留空数组不预约线下。线上是否允许由 SEU_ENABLE_ONLINE 控制。
# 默认列出学校全部校区；可删减为只允许部分校区。
SEU_PREFERRED_CAMPUS='["九龙湖校区","四牌楼校区","丁家桥校区","无锡校区","苏州校区"]'
SEU_ENABLE_ONLINE=true
SEU_ENABLE_OFFLINE=true
SEU_STATE_DIR=state

# 可选：记住此设备（默认关闭，仅接受 true/false）。开启后登录会像浏览器勾选“记住此设备，
# 下次免二次验证”一样向学校声明信任，并在状态目录保存两类仅本地文件：随机指纹
# device-fingerprint 和学校登录 Cookie trust-cookies.json（内容不打印、不进日志/邮件/仓库）。
# 2026-10-30 首次实测只发送指纹字段未能免短信；因此登录成功后还会保存域名以 seu.edu.cn
# 结尾的学校 CAS Cookie（仅 name/value/domain/path/secure/expires，加账号归属哈希），下次静默登录使用，
# Cookie 有效时可能免密码/短信；无归属、异账号、过期或损坏文件回退原短信流程。Cookie 文件等效登录凭据：
# 不要提交或分享，删除它只会结束静默登录。会话过期仍要重新登录；不要在共享或公用电脑开启。
# --check 开启时也会读写这两个文件（仍不创建任务、不写诊断、不预约）。
SEU_TRUST_DEVICE=false

# 开抢提速实验项，默认开启，可分别关闭：
# SEU_PREWARM=true 在开抢前约 2 秒用主会话刷新一次历史，保持验证码/提交连接热度；超时上界约 1.5 秒，
# 距开放不足 0.4 秒时跳过。
# SEU_CAPTCHA_PREFETCH=true 在开抢前约 0.6 秒预取验证码并识别，候选出现后直接提交，
# 被服务端判错、超时或超过 5 秒未用时会回退为现场取图；距开放不足 0.45 秒时跳过。
# 两项都按活动列表里稳定的学校开抢时间戳去重，同一场最多各执行一次。观测数据见诊断：
# CLI 在 state/diagnostics.jsonl；Web 在 <数据根>/accounts/<id>/diagnostics.jsonl。
SEU_PREWARM=true
SEU_CAPTCHA_PREFETCH=true
# 实验性开抢对齐（默认关闭）：把某一次后台轮询对齐到开抢时刻。校时校准后目标取最早的
# 估算时间（通常早于真实开抢），尚未校时的首次对齐仍可能偏差；如需实验请在真实开抢中对比后再开启。
SEU_POLLER_ALIGN=false
# 开抢期活动列表目标间隔为 0.10 秒；“我的活动”由独立只读会话约每 5 秒刷新，
# 主线程及时采用新快照，历史缓存最多保留 10 秒。关闭后回到 60 秒缓存 + 同步刷新。
SEU_HISTORY_BACKGROUND=true

# 备用网关 IP：首次登录先使用正常 DNS，网关解析失败、连接关闭/重置或 TLS 意外断开后回退一次。
# 留空关闭回退；IP 可能变更。仍校验域名证书，不改变系统 DNS/TUN，详见 docs/usage.md。
SEU_VPN_IP=121.249.14.2

# 邮件通知可选；邮件配置均留空或缺省时不发邮件，事件仍记录在终端和本地日志。
# QQ／163／126／Gmail 只需完整邮箱地址和授权码；旧 CLI 默认自己给自己发信。
# Web 收信邮箱及启用/成功通知开关逐账号在网页设置，留空关闭，不回退发信邮箱。
# 开启后发送人工认证、查询或预约关键步骤持续五分钟失败、异常退出等重大告警；不发日报或恢复通知。
# SEU_MAIL_SUCCESS=true 时额外发送每次预约成功通知；false 或省略时保持只发重大告警。
# 成功通知由后台线程发送，不阻塞扫描。
# QQ／163／126 填 SMTP 授权码；Gmail 填应用专用密码（16字符，去掉分组空格）。
# 获取步骤见 docs/usage.md；不要填写邮箱网页登录密码。
SEU_MAIL_SUCCESS=true
SMTP_USERNAME=
SMTP_PASSWORD=
# 高级配置按需取消注释；已有完整 SMTP 配置仍可用。使用隐式 TLS。
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=your-address@gmail.com
# MAIL_TO=your-address@gmail.com
