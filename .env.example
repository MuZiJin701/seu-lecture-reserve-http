# 复制为 .env 后填写。配置修改后重启生效，进程环境变量优先。
# 网页使用者先设置管理员；学校账号和筛选在网页添加。详见 docs/usage.md、docs/web.md。
# 本文件只是样例；真实 .env 含密码，不要提交或分享。

# 管理台：明文 HTTP，仅用于可信局域网或 VPN，不直接暴露公网。
# 将 {} 改为管理员账号和密码，例如 '{"admin":"换成你的密码"}'；{} 会导致启动失败。
SEU_WEB_ADMINS='{}'
SEU_WEB_HOST=0.0.0.0
SEU_WEB_PORT=8080

# 网页与 --account 共用的数据目录，含明文学校密码和 Cookie；升级时完整备份。
SEU_DATA_DIR=state

# 邮件可选：不用时留空。网页中每个学校账号另填收信邮箱，留空不发信。
# QQ、163、126、Gmail 可按域名选择主机；这里填 SMTP 授权码／应用专用密码。
SMTP_USERNAME=
SMTP_PASSWORD=

# 其他邮箱可指定以下高级配置（隐式 TLS）：
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# MAIL_FROM=sender@example.com

# 首次认证失败时的备用网关 IP；是否可用需按实际网络判断，留空关闭，仍校验证书。
SEU_VPN_IP=121.249.14.2

# 以下只用于不带 --account 的单账号 CLI；网页账号不使用这些学校凭据和筛选。
SEU_CARD_NUMBER=
SEU_PASSWORD=
SEU_STATE_DIR=state

# 保存设备指纹与学校 Cookie 尝试免短信；不保证生效，勿在公用电脑启用。
SEU_TRUST_DEVICE=true

# 筛选：空标题列表不限标题；类别按顺序优先；沙龙不计参考目标。
# 线下仍受校区限制，空校区列表不约线下。
SEU_PREFERRED_LECTURES='[]'
SEU_REQUIRED_CATEGORIES='["人文与科学素养系列讲座_心理健康","人文与科学素养系列讲座_法律","人文与科学素养系列讲座-艺术类","人文与科学素养系列讲座_其他","“SEU咖啡间”系列沙龙活动"]'
SEU_PREFERRED_CAMPUS='["九龙湖校区","四牌楼校区","丁家桥校区","无锡校区","苏州校区"]'
SEU_ENABLE_ONLINE=true
SEU_ENABLE_OFFLINE=true

# 开抢排程和预约时间窗判断使用运行机器的时钟，请在系统层保持时钟同步。
# 在公布的开放时间前 2.7 秒预取验证码；网页账号统一开启。
SEU_CAPTCHA_PREFETCH=true
# 进入快抢期时通知历史线程预热一次，并为主会话建立可复用连接；网页账号统一开启。
SEU_PREWARM=true

# 单账号 CLI 的成功通知；关闭后仍可发重要告警，不发日报。
# CLI 收信人默认是发信邮箱，可取消下一行注释来指定；网页账号不使用此值。
# MAIL_TO=recipient@example.com
SEU_MAIL_SUCCESS=true
