# 复制为 .env 后填写；不要提交真实 .env 或凭据。
# Web 启动：seu-reserve-web；旧单账号 CLI 启动：main.py（不带 --account）。
# Web 与 main.py --account 的学校账号、邮箱和可见筛选在网页设置；提速与信任选项统一开启。
# 程序默认读取当前目录的 .env，进程环境变量优先；相对路径以配置文件所在目录为准。
# 开关只填 true/false；列表填 JSON 数组并用单引号包裹；含空格或 # 的字符串也用单引号包裹。
# ${...} 保留原文，不做变量展开。详细说明：docs/web.md、docs/usage.md。

# ── 1. Web 管理台专用 ────────────────────────────────────────────────────────
# 管理台为明文 HTTP、需要管理员登录，仅限可信局域网或 VPN，不要暴露到公网。
# 学校凭据在本地明文保存；HTTP 不加密登录口令和会话。

# 管理员列表：用户名 -> 直接填写的密码，例如：'{"admin":"换成你的密码","other":"另一个密码"}'。
# 也兼容 --hash-password 生成的完整哈希；该命令可选，不需要先执行。
# 普通密码为 1–1024 字符；pbkdf2_sha256$ 前缀保留给哈希。此文件含明文密码，请勿提交或分享。
# 空列表会拒绝启动；可添加多个同等权限管理员。增删或改密后重启管理服务生效。
SEU_WEB_ADMINS='{}'

# 监听地址；0.0.0.0 表示所有网卡。本机浏览器用 127.0.0.1，其他机器用服务器实际 IP。
SEU_WEB_HOST=0.0.0.0

# 监听端口；按本样例，本机访问 http://127.0.0.1:8080。
SEU_WEB_PORT=8080

# ── 2. Web 与 CLI 共用 ───────────────────────────────────────────────────────

# Web 与 main.py --account 的数据根，保存账号数据库和各账号状态；缺省沿用 SEU_STATE_DIR，再缺省 state。
SEU_DATA_DIR=state

# 公共发信配置（可选，使用隐式 TLS）。Web 各账号邮箱留空不发信，填写后自动开启重大告警和成功通知。
# 不使用邮件时，发信与收信字段均留空或保持注释。
# 发信邮箱；QQ、163、126、Gmail 可按邮箱域名自动选择 SMTP 主机。
SMTP_USERNAME=

# SMTP 授权码或应用专用密码，不是邮箱网页登录密码；获取方法见 docs/usage.md。
SMTP_PASSWORD=

# 自定义 SMTP 主机；其他邮箱需设置，取消注释后优先于自动选择。
# SMTP_HOST=smtp.gmail.com

# SMTP 端口；缺省为 465。
# SMTP_PORT=465

# 发件人地址；缺省使用 SMTP_USERNAME。
# MAIL_FROM=your-address@gmail.com

# 备用学校网关 IP；首次登录先用正常 DNS，遇解析失败或特定连接/TLS 断开时回退一次。
# 留空关闭；回退仍校验域名证书，不修改系统 DNS/TUN，地址失效时需自行更新。
SEU_VPN_IP=121.249.14.2

# ── 3. 旧单账号 CLI 专用（main.py 不带 --account） ────────────────────────────
# 以下值不控制 Web 或 main.py --account 的账号行为；这些模式使用网页保存的账号设置。
# 本样例把可选项（记住此设备、四类开抢提速、成功通知）全部设为 true；不需要的改为 false。

# 账号与认证
# 学校一卡通号；兼容 SEU_USERNAME，同一配置来源中 SEU_CARD_NUMBER 优先。
SEU_CARD_NUMBER=

# 学校统一身份认证密码。
SEU_PASSWORD=

# CLI 状态目录，保存任务、设备信任和诊断文件；SEU_DATA_DIR 未配置时也沿用此值。
SEU_STATE_DIR=state

# 记住此设备（样例开启；程序缺省关闭）：保存设备指纹与学校登录 Cookie，下次尝试免短信登录，不保证生效。
# Cookie 等效登录凭据，勿分享或在公用电脑开启；--check 开启此项时也会读写设备信任文件。
SEU_TRUST_DEVICE=true

# 预约筛选
# 指定完整讲座标题（精确匹配）；[] 表示不限标题，仍须满足其他筛选和时间冲突规则。
SEU_PREFERRED_LECTURES='[]'

# 允许预约的类别，按列表顺序优先；目标固定为选听 8 场正式讲座，法律、艺术、心理各至少 1 场。
# 沙龙可预约但不计入目标；测试活动和购票公告不预约。
SEU_REQUIRED_CATEGORIES='["人文与科学素养系列讲座_心理健康","人文与科学素养系列讲座_法律","人文与科学素养系列讲座-艺术类","人文与科学素养系列讲座_其他","“SEU咖啡间”系列沙龙活动"]'

# 允许的线下校区；本样例列出全部校区，可删减；[] 表示不预约线下，不影响线上。
SEU_PREFERRED_CAMPUS='["九龙湖校区","四牌楼校区","丁家桥校区","无锡校区","苏州校区"]'

# 是否允许预约线上讲座。
SEU_ENABLE_ONLINE=true

# 是否允许预约线下讲座；开启后仍须在上述校区范围内。
SEU_ENABLE_OFFLINE=true

# 开抢提速（与网页选项同名，各自独立设置）
# 时间按学校时钟估算；预热、验证码预取和对齐在准备时间不足或校时不可靠时会跳过。

# 开抢前预热：开抢前约 2 秒用主会话查询一次“我的活动”，更新已有预约并保持连接活跃。
SEU_PREWARM=true

# 提前获取验证码：开抢前约 0.6 秒下载并识别，发现候选后直接使用。
# 超时、判错或超过 5 秒未用时，回退为现场取图。
SEU_CAPTCHA_PREFETCH=true

# 后台刷新已有预约：开抢期间约每 5 秒后台查询“我的活动”，更新进度、防重和时间冲突信息。
# 启用时只使用 10 秒内的可靠缓存；关闭后回到 60 秒缓存与主线程同步查询。
SEU_HISTORY_BACKGROUND=true

# 实验性开抢对齐：调整某次活动列表查询的发起时间，尽量靠近估算的开抢时刻。
# 样例开启；程序缺省关闭，实际提速收益仍需验证；不增加查询次数。
SEU_POLLER_ALIGN=true

# CLI 邮件通知（发信配置见第 2 节）
# 是否额外发送每次预约成功通知；本样例开启，程序缺省关闭。邮件已配置时，关闭此项仍发重大告警。
SEU_MAIL_SUCCESS=true

# CLI 收信人；未设置时发给自己。Web 的收信人在网页设置，不使用此值。
# MAIL_TO=your-address@gmail.com
